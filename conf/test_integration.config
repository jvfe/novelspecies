/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Integration test config – real Buchnera aphidicola genomes (~640 kb each)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Uses a pre-built reference sheet (type strain GCF_000007365.1) and two query
    strains (GCF_000007725.1, GCF_000009605.1) expected to exceed ANI/dDDH species
    boundaries relative to the type strain.
*/

params {
    input                   = "${projectDir}/tests/data/integration/samplesheet.csv"
    reference_sheet         = "${projectDir}/tests/data/integration/reference_sheet.csv"
    skip_reference_download = true

    outdir                  = "${launchDir}/results"
    skip_ddh                = false
    ddh_method              = 'local'
    ddh_top_n               = 1
    skip_intra_genus_ani    = false
    skip_heatmap            = true

    // Buchnera genomes are tiny; keep resources modest
    max_references_per_genus = 5
}

process {
    resourceLimits = [
        cpus: 4,
        memory: '8.GB',
        time: '2.h'
    ]

    withName: 'NCBI_DATASETS_DOWNLOAD' {
        cpus   = 1
        memory = 4.GB
    }

    withName: 'FASTANI_QUERY_VS_REFERENCE' {
        cpus   = 2
        memory = 4.GB
    }

    withName: 'GBDP_DDH' {
        cpus   = 2
        memory = 4.GB
    }
}
