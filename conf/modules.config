/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'GUNZIP' {
        publishDir = [
            enabled: false
        ]
    }

    withName: 'PREPARE_QUERY_LIST' {
        publishDir = [
            path: { "${params.outdir}/prepare" },
            mode: params.publish_dir_mode,
            pattern: "query_list.txt"
        ]
    }

    withName: 'NCBI_DATASETS_DOWNLOAD' {
        publishDir = [
            enabled: false
        ]
    }

    withName: 'NCBI_DATASETS_STAGE' {
        publishDir = [
            path: { "${params.outdir}/references/${meta.genus}" },
            mode: params.publish_dir_mode,
            pattern: "*.{tsv,txt}"
        ]
    }

    withName: 'FASTANI_QUERY_VS_REFERENCE' {
        ext.prefix = { "${meta.genus}_query_vs_reference" }
        publishDir = [
            path: { "${params.outdir}/ani" },
            mode: params.publish_dir_mode,
            pattern: "*.tsv"
        ]
    }

    withName: 'FASTANI_INTRA_GENUS' {
        ext.prefix = { "${meta.genus}_intra_genus" }
        publishDir = [
            path: { "${params.outdir}/ani" },
            mode: params.publish_dir_mode,
            pattern: "*.tsv"
        ]
    }

    withName: 'ANI_HEATMAP' {
        ext.prefix = { "${meta.genus}" }
        publishDir = [
            path: { "${params.outdir}/ani/heatmaps" },
            mode: params.publish_dir_mode,
            pattern: "*.{png,tsv,newick}"
        ]
    }

    // BLAST+ settings recommended for GBDP formula d4 by Meier-Kolthoff et al. 2013:
    // increased initial word size and no e-value filtering.
    withName: 'GBDP_DDH' {
        ext.args   = '-task blastn -word_size 38 -dust no -evalue 1e-2 -max_target_seqs 1000000'
        ext.prefix = { "${meta.id}_vs_${meta.ref_accession}" }
        publishDir = [
            path: { "${params.outdir}/ddh/pairwise" },
            mode: params.publish_dir_mode,
            pattern: "*.tsv"
        ]
    }

    withName: 'GGDC_BUNDLE' {
        publishDir = [
            path: { "${params.outdir}/ddh/ggdc_submissions" },
            mode: params.publish_dir_mode,
            pattern: "*.{tsv,txt,tar.gz}"
        ]
    }

    withName: 'GGDC_INGEST' {
        publishDir = [
            path: { "${params.outdir}/ddh" },
            mode: params.publish_dir_mode,
            pattern: "*.tsv"
        ]
    }

    withName: 'SPECIES_DECISION' {
        publishDir = [
            [
                path: { "${params.outdir}" },
                mode: params.publish_dir_mode,
                pattern: "species_delimitation_summary.tsv"
            ],
            [
                path: { "${params.outdir}/summary" },
                mode: params.publish_dir_mode,
                pattern: "*.{tsv,html}"
            ]
        ]
    }
}
